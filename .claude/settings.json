{
  "permissions": {
    "allow": [
      "Bash(python3 tools/check_site.py)",
      "Bash(python3 tools/check_charts.py)",
      "Bash(python3 tools/gen_charts.py)",
      "Bash(python3 tools/gen_features.py)",
      "Bash(python3 tools/gen_calculators.py .)",
      "Bash(python tools/check_site.py)",
      "Bash(python tools/check_charts.py)",
      "Bash(python tools/gen_charts.py)",
      "Bash(python tools/gen_features.py)",
      "Bash(python tools/gen_calculators.py .)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "P=python3; $P -c \"\" 2>/dev/null || P=python; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/incost_hook.py\" pre" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "P=python3; $P -c \"\" 2>/dev/null || P=python; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/incost_hook.py\" post" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "P=python3; $P -c \"\" 2>/dev/null || P=python; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/incost_hook.py\" stop" }
        ]
      }
    ]
  }
}
